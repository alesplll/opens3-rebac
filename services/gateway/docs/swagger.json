{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Minimal object PUT/GET without authentication, authorization, quota or S3 compatibility. Do not expose publicly.",
        "title": "OpenS3 Gateway (development API)",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/{bucket}/{key}": {
            "get": {
                "description": "Development-only API. Streams object bytes; range and version selection are not supported.",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "objects"
                ],
                "summary": "Read the current object version",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bucket name",
                        "name": "bucket",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Object key (may contain slashes)",
                        "name": "key",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "Development-only API. No authentication, authorization or quota enforcement. A failed response after Storage may have an unknown Metadata outcome; do not retry blindly.",
                "consumes": [
                    "application/octet-stream"
                ],
                "tags": [
                    "objects"
                ],
                "summary": "Store an object in an existing bucket",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bucket name",
                        "name": "bucket",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Object key (may contain slashes)",
                        "name": "key",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Raw object bytes",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "type": "string",
                        "description": "MIME type",
                        "name": "Content-Type",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "507": {
                        "description": "Insufficient Storage",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}